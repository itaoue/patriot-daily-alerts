# Copy to .env for local development. Railway injects these as service variables.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-password
# Railway Postgres plugin sets DATABASE_URL automatically. Leave empty locally to use SQLite.
DATABASE_URL=
SITE_URL=https://patriotdailyalerts.com
SITE_NAME=Patriot Daily Alerts
CONTACT_EMAIL=news@patriotdailyalerts.com
GA_MEASUREMENT_ID=G-7J6WNSF6DJ
# Outgoing mail: editor notifications and the reader welcome email.
# Either RESEND_API_KEY (recommended) or the SMTP_* block. MAIL_FROM should match the newsletter's From address.
RESEND_API_KEY=
MAIL_FROM=news@patriotdailyalerts.com
NOTIFY_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Optional: push subscribers to BigMailer
BIGMAILER_API_KEY=
BIGMAILER_BRAND_ID=
BIGMAILER_LIST_ID=
# Set FLASK_ENV=development locally so the session cookie works over http
FLASK_ENV=development
